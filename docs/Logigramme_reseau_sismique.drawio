        <mxCell id="v3" value="RÉSEAU EMBARQUÉ SISMIQUE     /     11" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#B7D5E8;fontStyle=1;fillColor=none;strokeColor=none;connectable=0;" vertex="1" parent="1">
