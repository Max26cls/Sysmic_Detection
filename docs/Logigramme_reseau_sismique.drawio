        <mxCell id="dma_config" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1D695B&quot;&gt;&lt;b&gt;adc_dma_config()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Configurer les entrées analogiques et le transfert continu.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;configure_adc_scan(RANK_X,&amp;nbsp;RANK_Y,&amp;nbsp;RANK_Z);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;set_adc_external_trigger(TIM_TRGO);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;set_timer_frequency_hz(100);&amp;nbsp;&amp;nbsp;//&amp;nbsp;un&amp;nbsp;triplet&amp;nbsp;par&amp;nbsp;10&amp;nbsp;ms&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;configure_dma_circular(2&amp;nbsp;*&amp;nbsp;BLOCK_SAMPLES&amp;nbsp;*&amp;nbsp;AXES);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;enable_half_and_full_dma_callbacks();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;prepare_dma_memory_and_cache_policy();&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dma_start" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1D695B&quot;&gt;&lt;b&gt;acq_start() / acq_stop()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;T02 contrôle la durée de vie du timer et du DMA.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;reset_sample_seq_and_dma_notifications();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;HAL_ADC_Start_DMA(adc,&amp;nbsp;dma_buffer,&amp;nbsp;DMA_LENGTH);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;HAL_TIM_Base_Start(sample_timer);&amp;nbsp;set_ready_bit(T02);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;À&amp;nbsp;l&amp;#x27;arrêt&amp;nbsp;:&amp;nbsp;arrêter&amp;nbsp;le&amp;nbsp;timer&amp;nbsp;avant&amp;nbsp;l&amp;#x27;ADC&amp;nbsp;et&amp;nbsp;le&amp;nbsp;DMA.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;HAL_TIM_Base_Stop(sample_timer);&amp;nbsp;HAL_ADC_Stop_DMA(adc);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;clear_pending_dma_events();&amp;nbsp;set_stopped_bit(T02);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dma_irq" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1D695B&quot;&gt;&lt;b&gt;adc_half_cb() / adc_full_cb() → dma_isr()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Callbacks HAL de mi-transfert et de fin de transfert.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;publish_dma_completion(half,&amp;nbsp;sample_seq,&amp;nbsp;timer_tick);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;sample_seq&amp;nbsp;+=&amp;nbsp;BLOCK_SAMPLES;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;vTaskNotifyGiveFromISR(acq_handle,&amp;nbsp;&amp;amp;wake);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;portYIELD_FROM_ISR(wake);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;ISR&amp;nbsp;:&amp;nbsp;publier&amp;nbsp;un&amp;nbsp;descripteur&amp;nbsp;borné.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Signaler&amp;nbsp;une&amp;nbsp;perte&amp;nbsp;si&amp;nbsp;un&amp;nbsp;bloc&amp;nbsp;a&amp;nbsp;été&amp;nbsp;remplacé.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
