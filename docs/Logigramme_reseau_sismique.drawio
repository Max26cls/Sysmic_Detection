        <mxCell id="wait" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#754A16&quot;&gt;&lt;b&gt;Attendre un candidat local venant de T03&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;RMS locale au-dessus du critère et fenêtre associée.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="213" width="650" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#754A16&quot;&gt;&lt;b&gt;Heure valide et&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;au moins un pair actif ?&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="296" width="380" height="88" as="geometry" />
        </mxCell>
        <mxCell id="isolated" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Garder une détection locale&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Tracer le motif, conserver les mesures.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Ne pas déclencher d’alerte collective.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1032" y="293" width="360" height="94" as="geometry" />
        </mxCell>
        <mxCell id="setup" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#754A16&quot;&gt;&lt;b&gt;Ouvrir une validation pour l’instant t₀&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Figer les pairs alors actifs, fixer une échéance et examiner les données reçues.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Pour chaque pair sans confirmation, demander à T06 la mesure du créneau.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="410" width="650" height="86" as="geometry" />
        </mxCell>
        <mxCell id="all" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#754A16&quot;&gt;&lt;b&gt;Tous les pairs confirment ?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;« alerte » et |t du pair − t₀| ≤ Δt&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="535" y="531" width="410" height="104" as="geometry" />
        </mxCell>
        <mxCell id="expired" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#754A16&quot;&gt;&lt;b&gt;Refus explicite d’un pair&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;ou échéance atteinte ?&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1022" y="531" width="380" height="104" as="geometry" />
        </mxCell>
        <mxCell id="next" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Attendre&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Mesure ou échéance.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Pair muet : inconnu.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1018" y="678" width="180" height="89" as="geometry" />
        </mxCell>
        <mxCell id="noalert" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Clore sans alerte&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Garder les mesures.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Revenir à l’attente.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="678" width="182" height="89" as="geometry" />
        </mxCell>
        <mxCell id="alarm" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#754A16&quot;&gt;&lt;b&gt;Activer la LED d’alerte dédiée&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Journaliser la secousse validée et son horodatage.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Tenir l’alerte pour la durée configurée, puis la réarmer.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="483" y="676" width="514" height="89" as="geometry" />
        </mxCell>
        <mxCell id="v23" value="Non" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="953" y="311" width="52" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v25" value="Oui" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="755" y="386" width="51" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v28" value="Oui" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="756" y="644" width="52" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v30" value="Non" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="957" y="553" width="48" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v32" value="Non" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1138" y="632" width="48" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v34" value="Oui" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1265" y="632" width="43" height="22" as="geometry" />
        </mxCell>
        <mxCell id="note849" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Critères proposés à régler sur le montage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Le statut JSON « alerte » indique un dépassement local. La LED collective exige la confirmation horodatée de chaque pair de l’instantané et de la carte elle-même.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Une réponse ciblée « normal » pour un créneau couvert vaut refus. Régler Δt et l’échéance selon la précision RTC et les délais de réponse du réseau.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="849" width="1400" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
