        </mxCell>
        <mxCell id="ok" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Écriture réussie ?&lt;/b&gt;&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="470" width="275" height="92" as="geometry" />
        </mxCell>
        <mxCell id="storeerr" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#8D403B&quot;&gt;&lt;b&gt;Signaler l’erreur&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Journaliser et réessayer de façon bornée.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Conserver la mise à jour en RAM pour&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;un nouvel essai ou l’arrêt.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FCE9E8;strokeColor=#BE7E77;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
