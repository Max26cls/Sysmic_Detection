        </mxCell>
        <mxCell id="v16" value="" style="rounded=1;arcSize=12;fillColor=#FFF0DB;strokeColor=none;html=1;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="770" y="157" width="658" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="VALIDATION.C  /  T12 ET LED D’ALERTE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#754A16;fontStyle=1;fillColor=none;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="782" y="157" width="634" height="36" as="geometry" />
        </mxCell>
        <mxCell id="val_start" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#754A16&quot;&gt;&lt;b&gt;start_candidate(local_frame)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Figer les pairs et appliquer un délai unique au candidat.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!local_frame.utc.valid)&amp;nbsp;return&amp;nbsp;LOCAL_ONLY;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;active&amp;nbsp;=&amp;nbsp;copy_active_peers();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(active.empty())&amp;nbsp;return&amp;nbsp;LOCAL_ONLY;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;candidate&amp;nbsp;=&amp;nbsp;make_candidate(local_frame.utc,&amp;nbsp;delta,&amp;nbsp;deadline);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;seed_confirmations_from_recent_peer_alerts(candidate,&amp;nbsp;active);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;request_missing_peers_after_window_end(Q_REQUESTS,&amp;nbsp;candidate);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="val_loop" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#754A16&quot;&gt;&lt;b&gt;validation_task() / update_candidate()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Un candidat actif à la fois, avec fusion des candidats proches.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;wait_signal_or_deadline(Q_VALIDATION);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!RUN)&amp;nbsp;return&amp;nbsp;stop_and_turn_led_off();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(local_candidate)&amp;nbsp;admit_or_merge_local_candidate();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(lost_event&amp;nbsp;||&amp;nbsp;clock_changed)&amp;nbsp;return&amp;nbsp;close_without_alert();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(peer_alert_within_delta)&amp;nbsp;mark_confirmed(peer);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(targeted_normal_for_current_candidate)&amp;nbsp;mark_refused(peer);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(any_refused&amp;nbsp;||&amp;nbsp;now_at_deadline)&amp;nbsp;close_without_alert();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;else&amp;nbsp;if&amp;nbsp;(all_confirmed)&amp;nbsp;raise_collective_alert();&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="val_alert" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#754A16&quot;&gt;&lt;b&gt;raise_collective_alert()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Allumer la LED dédiée et garder le traitement événementiel.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;set_alert_led(true);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;log_confirmed_event(candidate.utc,&amp;nbsp;candidate.peer_count);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;led_off_deadline&amp;nbsp;=&amp;nbsp;monotonic_now()&amp;nbsp;+&amp;nbsp;ALERT_DURATION;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;close_candidate();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;À&amp;nbsp;l&amp;#x27;échéance&amp;nbsp;de&amp;nbsp;la&amp;nbsp;LED,&amp;nbsp;ou&amp;nbsp;si&amp;nbsp;RUN&amp;nbsp;tombe&amp;nbsp;:&amp;nbsp;LED&amp;nbsp;éteinte.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Enregistrer&amp;nbsp;les&amp;nbsp;mesures&amp;nbsp;par&amp;nbsp;T07&amp;nbsp;via&amp;nbsp;la&amp;nbsp;file&amp;nbsp;FRAM.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="654" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="note890" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Intégration&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Prévoir un délai pour terminer le créneau et interroger les pairs. Un silence ou une réponse unavailable laisse le pair inconnu jusqu’à l’expiration.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1400" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
