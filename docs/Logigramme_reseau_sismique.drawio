        <mxCell id="rtc_end" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Terminer l’accès I²C&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Signaler STOPPED, puis attendre RUN.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="731" width="372" height="76" as="geometry" />
        </mxCell>
        <mxCell id="hb_init" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Préparer la LED de vie&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Configurer l’état initial de la LED heartbeat.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Fixer la première échéance et signaler READY.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Utiliser la LED de vie prévue pour T09.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="554" y="289" width="372" height="126" as="geometry" />
        </mxCell>
        <mxCell id="hb_wait" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Attendre l’échéance périodique&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Relire RUN à la fin de l’attente bornée.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
