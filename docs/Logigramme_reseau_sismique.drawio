        <mxCell id="udp_tx" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#57418C&quot;&gt;&lt;b&gt;udp_announce_task()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Envoyer une annonce au démarrage du lien, puis toutes les 30 s.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;wait_event(RUN);&amp;nbsp;open_udp_broadcast_socket();&amp;nbsp;ready(T04);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;while&amp;nbsp;(run_is_set())&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;wait_next_announce_or_link_ready();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(!run_is_set())&amp;nbsp;break;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(link_up())&amp;nbsp;send_presence();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;close_socket();&amp;nbsp;stopped(T04);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="udp_msg" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#57418C&quot;&gt;&lt;b&gt;send_presence() / make_presence_json()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Le timestamp peut être nul si l’heure UTC est indisponible.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;msg&amp;nbsp;=&amp;nbsp;make_presence_json(node_id,&amp;nbsp;node_ip,&amp;nbsp;utc_now());&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!encode_json_bounded(msg,&amp;nbsp;out,&amp;nbsp;sizeof(out)))&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;log_error(JSON_TOO_LARGE);&amp;nbsp;return;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(sendto(udp,&amp;nbsp;out,&amp;nbsp;broadcast_ip,&amp;nbsp;12345)&amp;nbsp;&amp;lt;&amp;nbsp;0)&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;log_error(UDP_TX_ERROR);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="udp_cfg" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#57418C&quot;&gt;&lt;b&gt;validate_ip_config(config)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Vérifier l’adresse statique unicast et calculer le broadcast.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;mask&amp;nbsp;=&amp;nbsp;ipv4(&amp;#x27;255.255.255.240&amp;#x27;);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;network&amp;nbsp;=&amp;nbsp;ipv4(&amp;#x27;192.168.1.0&amp;#x27;);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;broadcast_ip&amp;nbsp;=&amp;nbsp;network&amp;nbsp;|&amp;nbsp;~mask;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;require((node_ip&amp;nbsp;&amp;amp;&amp;nbsp;mask)&amp;nbsp;==&amp;nbsp;network);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;require(node_ip&amp;nbsp;!=&amp;nbsp;network&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;node_ip&amp;nbsp;!=&amp;nbsp;broadcast_ip);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;require(nonempty_unique_node_id);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="654" width="636" height="205" as="geometry" />
        </mxCell>
