        <mxCell id="v11" value="TCP_CLIENT.C  /  T06 SYNCHRONISATION ET REQUÊTES" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#57418C;fontStyle=1;fillColor=none;strokeColor=none;connectable=0;" vertex="1" parent="1">
