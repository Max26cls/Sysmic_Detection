        <mxCell id="boot" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Mise sous tension / reset&lt;/b&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="74" y="212" width="340" height="53" as="geometry" />
        </mxCell>
        <mxCell id="init" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Préparer le système&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Initialiser le matériel et l’adressage IP.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Créer les files, mutex et groupes d’événements.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Créer T01 à T12. Les services attendront RUN.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="74" y="290" width="340" height="114" as="geometry" />
        </mxCell>
        <mxCell id="good" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Initialisation valide ?&lt;/b&gt;&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="92" y="427" width="304" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fault_boot" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#8D403B&quot;&gt;&lt;b&gt;Défaut d’initialisation&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Signaler le diagnostic disponible.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Attendre un reset.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FCE9E8;strokeColor=#BE7E77;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="74" y="558" width="340" height="79" as="geometry" />
        </mxCell>
        <mxCell id="idle" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;ATTENTE · RUN effacé&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;T01 dort jusqu’à la notification du bouton, puis vérifie l’anti-rebond.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="547" y="215" width="540" height="58" as="geometry" />
        </mxCell>
        <mxCell id="start" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Ouvrir le cycle&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Réinitialiser les confirmations. Positionner le bit RUN.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Les services se réveillent, préparent leur ressource et signalent READY.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="547" y="303" width="540" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Tous prêts à temps ?&lt;/b&gt;&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="672" y="401" width="290" height="74" as="geometry" />
        </mxCell>
        <mxCell id="running" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;EN MARCHE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;T01 attend le prochain appui validé ou traite un arrêt déjà demandé.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="547" y="498" width="540" height="59" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;1   Arrêter les producteurs&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Effacer RUN. T02 coupe le timer et le DMA, T06/T11 ferment leurs sockets.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Attendre STOPPED des services sauf T07 FRAM et T10 Journal.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="547" y="586" width="540" height="82" as="geometry" />
        </mxCell>
        <mxCell id="fram" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;2   Terminer les écritures FRAM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Autoriser T07 à vider sa file, puis attendre son bit STOPPED.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="547" y="700" width="540" height="75" as="geometry" />
        </mxCell>
        <mxCell id="uart" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;3   Terminer le journal UART&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Autoriser T10 à vider sa file, puis attendre son bit STOPPED.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="547" y="805" width="540" height="75" as="geometry" />
        </mxCell>
        <mxCell id="fault" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#8D403B&quot;&gt;&lt;b&gt;Défaut de cycle&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Effacer RUN et tracer le défaut.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Attendre un reset.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FCE9E8;strokeColor=#BE7E77;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1123" y="390" width="285" height="100" as="geometry" />
        </mxCell>
        <mxCell id="stop_note" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Échéance par phase&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Passer à la phase suivante après&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;les confirmations attendues.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;En cas d’échéance, passer en défaut.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Le bouton reste géré par T01.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1123" y="567" width="285" height="121" as="geometry" />
        </mxCell>
        <mxCell id="rearm" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Préparer le retour à l’attente&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Éteindre les deux LED.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Purger les anciens travaux restants.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Les tâches se rebloquent sur RUN.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1123" y="735" width="285" height="117" as="geometry" />
        </mxCell>
