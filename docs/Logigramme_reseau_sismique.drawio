        </mxCell>
        <mxCell id="rtc_run" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;RUN actif ?&lt;/b&gt;&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="126" y="528" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rtc_tick" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Lire la RTC et publier le cache UTC&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Mettre à jour l’heure et sa validité.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
