        <mxCell id="rtc_init" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Préparer la référence UTC&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Lire la RTC sur I²C, puis signaler READY.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Essayer NTP au démarrage avec un délai borné.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Si NTP répond, ajuster la RTC.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Si l’heure reste inconnue, la déclarer invalide.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="289" width="372" height="126" as="geometry" />
        </mxCell>
        <mxCell id="rtc_wait" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Attendre la prochaine lecture RTC&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Garder cette attente bornée pour l’arrêt.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
