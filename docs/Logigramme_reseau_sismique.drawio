        </mxCell>
        <mxCell id="v17" value="APP_TYPES.H  /  CONTRATS ET VÉRIFICATIONS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#25465B;fontStyle=1;fillColor=none;strokeColor=none;connectable=0;" vertex="1" parent="1">
