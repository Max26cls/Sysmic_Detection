        <mxCell id="v4" value="Acquérir les trois axes à 100 Hz" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=33;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;connectable=0;" vertex="1" parent="1">
