        <mxCell id="button" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Bouton GPIO · ISR EXTI&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Notification directe à T01&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="68" y="210" width="340" height="61" as="geometry" />
        </mxCell>
        <mxCell id="dma" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Timer → ADC XYZ → DMA à 100 Hz&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;ISR de fin de bloc DMA → notification à T02&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="210" width="480" height="61" as="geometry" />
        </mxCell>
        <mxCell id="eth" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Pilote Ethernet et pile IP&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Sockets UDP et TCP pour T04, T05, T06 et T11&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1054" y="210" width="364" height="61" as="geometry" />
        </mxCell>
        <mxCell id="master" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;T01 Maître&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Attend l’appui et pilote le cycle.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="68" y="382" width="340" height="68" as="geometry" />
        </mxCell>
        <mxCell id="cycle" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;Groupe d’événements&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Signal RUN commun aux 11 tâches de service.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Confirmations READY et STOPPED vers T01.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="68" y="474" width="340" height="79" as="geometry" />
        </mxCell>
        <mxCell id="rtc" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;T08 Heure&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;RTC sur I²C, mise à l’heure NTP au démarrage.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Publie une référence UTC pour les tâches.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="68" y="574" width="340" height="76" as="geometry" />
        </mxCell>
        <mxCell id="led_life" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1F4B75&quot;&gt;&lt;b&gt;T09 Heartbeat&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Attend sa période. Fait clignoter la LED de vie&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;pendant le cycle actif.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="68" y="675" width="340" height="77" as="geometry" />
        </mxCell>
