        </mxCell>
        <mxCell id="note791" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Partage des ressources&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Un propriétaire par périphérique : T07 pour la FRAM SPI, T08 pour la RTC I²C et T10 pour l’UART. Protéger les instantanés partagés par des mutex courts.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Les tâches attendent sur notification, queue ou délai. Relâcher les mutex avant le réseau et les écritures SPI. Utiliser les confirmations d’arrêt avec échéance.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="791" width="1400" height="72" as="geometry" />
        </mxCell>
        <mxCell id="note873" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Référence temporelle&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Au démarrage, interroger be.pool.ntp.org avec un délai borné. En cas d’échec, utiliser la RTC si elle est valide. Dater en UTC et cadencer les tâches en temps monotone.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="873" width="1400" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
