        <mxCell id="fram_boot" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1D695B&quot;&gt;&lt;b&gt;fram_restore()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Relire le dernier instantané intact au démarrage.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;a&amp;nbsp;=&amp;nbsp;read_slot(SLOT_A);&amp;nbsp;b&amp;nbsp;=&amp;nbsp;read_slot(SLOT_B);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;a_ok&amp;nbsp;=&amp;nbsp;valid_marker_version_length_crc(a);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;b_ok&amp;nbsp;=&amp;nbsp;valid_marker_version_length_crc(b);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;snapshot&amp;nbsp;=&amp;nbsp;newest_valid(a,&amp;nbsp;a_ok,&amp;nbsp;b,&amp;nbsp;b_ok);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;restore_saved_local_records_for_readback(snapshot);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;restore_remote_per_axis_maxima_by_id(snapshot);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="fram_run" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1D695B&quot;&gt;&lt;b&gt;fram_task() / merge_updates(update)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Conserver 10 RMS par axe en local et 1 maximum par axe et par pair.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;wait_event(RUN);&amp;nbsp;fram_restore_once();&amp;nbsp;ready(T07);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;while&amp;nbsp;(!event_is_set(FLUSH_FRAM))&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(receive_fram_update(&amp;amp;u,&amp;nbsp;T_SHORT))&amp;nbsp;merge_updates(u);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(commit_due())&amp;nbsp;fram_commit_pending();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;drain_fram_updates();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(fram_commit_pending())&amp;nbsp;stopped(T07);&amp;nbsp;else&amp;nbsp;signal_fault();&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="fram_commit" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1D695B&quot;&gt;&lt;b&gt;fram_commit_pending()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Proposition : deux emplacements, avec marqueur valide écrit en dernier.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!dirty)&amp;nbsp;return&amp;nbsp;true;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;slot&amp;nbsp;=&amp;nbsp;inactive_slot();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;invalidate(slot);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;write_header_payload_crc(slot,&amp;nbsp;next_version,&amp;nbsp;snapshot);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!readback_and_check_crc(slot))&amp;nbsp;return&amp;nbsp;keep_dirty_and_retry();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;commit_valid_marker(slot);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;return&amp;nbsp;verify_commit_and_clear_dirty(slot);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="654" width="636" height="205" as="geometry" />
        </mxCell>
