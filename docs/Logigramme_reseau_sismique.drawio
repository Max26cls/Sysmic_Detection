        <mxCell id="types_local" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#25465B&quot;&gt;&lt;b&gt;Types de données locaux&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Utiliser le même ordre d’axes, les mêmes unités et des tailles bornées.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;SampleBlock&amp;nbsp;=&amp;nbsp;{&amp;nbsp;first_seq,&amp;nbsp;first_tick,&amp;nbsp;count,&amp;nbsp;xyz[]&amp;nbsp;};&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;RmsFrame&amp;nbsp;=&amp;nbsp;{&amp;nbsp;sample_tick,&amp;nbsp;utc,&amp;nbsp;xyz_rms[3],&amp;nbsp;local_status&amp;nbsp;};&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;TopEntry&amp;nbsp;=&amp;nbsp;{&amp;nbsp;axis,&amp;nbsp;rms,&amp;nbsp;utc,&amp;nbsp;sample_tick&amp;nbsp;};&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;LocalTop10&amp;nbsp;=&amp;nbsp;{&amp;nbsp;top[3][10],&amp;nbsp;counts[3]&amp;nbsp;};&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;FramUpdate&amp;nbsp;=&amp;nbsp;LOCAL_TOP10&amp;nbsp;|&amp;nbsp;PEER_MAX_CANDIDATE;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Ajouter&amp;nbsp;des&amp;nbsp;compteurs&amp;nbsp;par&amp;nbsp;type&amp;nbsp;de&amp;nbsp;pertes&amp;nbsp;et&amp;nbsp;d&amp;#x27;erreurs.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="types_net" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#25465B&quot;&gt;&lt;b&gt;Contrats réseau et configuration&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Dimensionner à partir des paramètres du projet.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;Peer&amp;nbsp;=&amp;nbsp;{&amp;nbsp;id,&amp;nbsp;ipv4,&amp;nbsp;last_seen_tick&amp;nbsp;};&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;ValidationJob&amp;nbsp;=&amp;nbsp;{&amp;nbsp;candidate_id,&amp;nbsp;t0,&amp;nbsp;delta,&amp;nbsp;deadline,&amp;nbsp;peers&amp;nbsp;};&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;ValidationEvent&amp;nbsp;=&amp;nbsp;LOCAL_CANDIDATE&amp;nbsp;|&amp;nbsp;PEER_DATA&amp;nbsp;|&amp;nbsp;IO_STATUS;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;TCP_PORT&amp;nbsp;=&amp;nbsp;UDP_PORT&amp;nbsp;=&amp;nbsp;12345;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;SAMPLE_HZ&amp;nbsp;=&amp;nbsp;100;&amp;nbsp;UDP_PERIOD_S&amp;nbsp;=&amp;nbsp;30;&amp;nbsp;SYNC_PERIOD_S&amp;nbsp;=&amp;nbsp;60;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Fixer&amp;nbsp;seuil,&amp;nbsp;delta,&amp;nbsp;tailles&amp;nbsp;des&amp;nbsp;files&amp;nbsp;et&amp;nbsp;délais&amp;nbsp;par&amp;nbsp;essais.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="types_test" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#25465B&quot;&gt;&lt;b&gt;Scénarios de vérification sur cartes&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Valider les points d’intégration dans le firmware.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;1.&amp;nbsp;Injection&amp;nbsp;XYZ&amp;nbsp;connue&amp;nbsp;:&amp;nbsp;filtre,&amp;nbsp;RMS&amp;nbsp;et&amp;nbsp;classement&amp;nbsp;Top&amp;nbsp;10.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;2.&amp;nbsp;Trou&amp;nbsp;DMA&amp;nbsp;:&amp;nbsp;pas&amp;nbsp;de&amp;nbsp;fenêtre&amp;nbsp;RMS&amp;nbsp;couvrant&amp;nbsp;le&amp;nbsp;trou.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;3.&amp;nbsp;Deux&amp;nbsp;cartes&amp;nbsp;:&amp;nbsp;découverte,&amp;nbsp;puis&amp;nbsp;trame&amp;nbsp;TCP&amp;nbsp;fragmentée.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;4.&amp;nbsp;Corrélation&amp;nbsp;:&amp;nbsp;tous&amp;nbsp;confirment,&amp;nbsp;un&amp;nbsp;refuse,&amp;nbsp;un&amp;nbsp;reste&amp;nbsp;muet.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;5.&amp;nbsp;Perte&amp;nbsp;RTC/NTP&amp;nbsp;:&amp;nbsp;mesure&amp;nbsp;locale&amp;nbsp;sans&amp;nbsp;alerte&amp;nbsp;collective.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;6.&amp;nbsp;Appui&amp;nbsp;en&amp;nbsp;activité&amp;nbsp;:&amp;nbsp;arrêt,&amp;nbsp;FRAM/UART&amp;nbsp;drainés,&amp;nbsp;puis&amp;nbsp;reprise.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="654" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="note890" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Intégration&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Le pseudo-C indique les blocs à écrire. Les handles HAL, les adresses de registres et les tailles RAM se définissent dans le projet cible.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1400" height="52" as="geometry" />
        </mxCell>
