        <mxCell id="dsp_task" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1D695B&quot;&gt;&lt;b&gt;dsp_task()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Consommer la file XYZ et repérer les discontinuités.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;wait_event(RUN);&amp;nbsp;reset_dsp_state();&amp;nbsp;ready(T03);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;while&amp;nbsp;(run_is_set())&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(!queue_receive(Q_XYZ,&amp;nbsp;&amp;amp;b,&amp;nbsp;T_SHORT))&amp;nbsp;continue;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(b.first_seq&amp;nbsp;!=&amp;nbsp;expected_seq)&amp;nbsp;reset_dsp_state();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;dsp_consume_block(b);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expected_seq&amp;nbsp;=&amp;nbsp;b.first_seq&amp;nbsp;+&amp;nbsp;b.count;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dsp_filter" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1D695B&quot;&gt;&lt;b&gt;dsp_consume_block(block)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Calibrer et lisser avec une moyenne glissante de N points.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;for&amp;nbsp;(i&amp;nbsp;=&amp;nbsp;0;&amp;nbsp;i&amp;nbsp;&amp;lt;&amp;nbsp;block.count;&amp;nbsp;++i)&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;for_each_axis&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;a&amp;nbsp;=&amp;nbsp;(raw[axis][i]&amp;nbsp;-&amp;nbsp;offset[axis])&amp;nbsp;*&amp;nbsp;scale[axis];&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sum[axis]&amp;nbsp;+=&amp;nbsp;a&amp;nbsp;-&amp;nbsp;ring_replace(axis,&amp;nbsp;a);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;advance_ring_once_per_triplet();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(ring_full())&amp;nbsp;rms_accumulate(sum&amp;nbsp;/&amp;nbsp;N,&amp;nbsp;tick_of(i));&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dsp_rms" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1D695B&quot;&gt;&lt;b&gt;rms_accumulate(filtered_xyz, sample_tick)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Fenêtres proposées sans chevauchement. 100 points = 1 seconde.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;sum_sq&amp;nbsp;+=&amp;nbsp;square_each_axis(filtered_xyz);&amp;nbsp;++n;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(n&amp;nbsp;&amp;lt;&amp;nbsp;RMS_SAMPLES)&amp;nbsp;return;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;frame.rms&amp;nbsp;=&amp;nbsp;sqrt_each_axis(sum_sq&amp;nbsp;/&amp;nbsp;n);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;frame.sample_tick&amp;nbsp;=&amp;nbsp;sample_tick;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;frame.utc&amp;nbsp;=&amp;nbsp;utc_from_tick(sample_tick);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;frame.status&amp;nbsp;=&amp;nbsp;local_thresholds(frame.rms);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;publish_local_frame(frame);&amp;nbsp;reset_rms_accumulators();&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="654" width="636" height="205" as="geometry" />
        </mxCell>
