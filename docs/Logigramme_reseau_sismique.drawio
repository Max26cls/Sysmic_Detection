        <mxCell id="v17" value="TCP_SERVER.C  /  T11 ET ENCADREMENT COMMUN" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#57418C;fontStyle=1;fillColor=none;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="782" y="157" width="634" height="36" as="geometry" />
        </mxCell>
        <mxCell id="tcp_rx" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#57418C&quot;&gt;&lt;b&gt;tcp_server_task()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Écouter, servir une requête avec délai puis reprendre l’écoute.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;wait_event(RUN);&amp;nbsp;listen_tcp(12345);&amp;nbsp;ready(T11);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;while&amp;nbsp;(run_is_set())&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;s&amp;nbsp;=&amp;nbsp;accept_until_timeout();&amp;nbsp;if&amp;nbsp;(s&amp;nbsp;&amp;lt;&amp;nbsp;0)&amp;nbsp;continue;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(recv_json_line(s,&amp;nbsp;&amp;amp;req,&amp;nbsp;io_deadline())&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;valid(req))&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;send_json_line(s,&amp;nbsp;dispatch_request(req));&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;close(s);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&amp;nbsp;&amp;nbsp;//&amp;nbsp;fermer&amp;nbsp;le&amp;nbsp;socket&amp;nbsp;d&amp;#x27;écoute,&amp;nbsp;puis&amp;nbsp;stopped(T11)&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="tcp_frame" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#57418C&quot;&gt;&lt;b&gt;recv_json_line() / send_json_line()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;TCP peut fragmenter une trame. Cadrage proposé par saut de ligne.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;while&amp;nbsp;(!has_newline&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;used&amp;nbsp;&amp;lt;&amp;nbsp;MAX_JSON&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;before(deadline))&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;n&amp;nbsp;=&amp;nbsp;recv_more(s,&amp;nbsp;buffer&amp;nbsp;+&amp;nbsp;used,&amp;nbsp;MAX_JSON&amp;nbsp;-&amp;nbsp;used);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(n&amp;nbsp;&amp;lt;=&amp;nbsp;0)&amp;nbsp;return&amp;nbsp;false;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;used&amp;nbsp;+=&amp;nbsp;n;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;return&amp;nbsp;has_newline&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;parse_one_bounded_json_object();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Envoi&amp;nbsp;:&amp;nbsp;encoder,&amp;nbsp;ajouter&amp;nbsp;&amp;#x27;\n&amp;#x27;&amp;nbsp;et&amp;nbsp;boucler&amp;nbsp;sur&amp;nbsp;les&amp;nbsp;envois&amp;nbsp;partiels.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="tcp_dispatch" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#57418C&quot;&gt;&lt;b&gt;dispatch_request(req)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Filtrer le type, identifier l’émetteur et choisir la réponse.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(req.type&amp;nbsp;==&amp;nbsp;SYNC)&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(req.has_data)&amp;nbsp;ingest_remote(req.data,&amp;nbsp;req.peer_id);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return&amp;nbsp;select_sync_frame(now()).or_else_unavailable();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(req.type&amp;nbsp;==&amp;nbsp;GET_EVENT)&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return&amp;nbsp;select_event_frame(req.t0,&amp;nbsp;req.delta);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;return&amp;nbsp;error_response(BAD_TYPE);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="654" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="note890" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Intégration&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Types proposés : sync, get_event, data et unavailable. Imposer une taille maximale, des délais finis et une réponse associée au pair attendu.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1400" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
