        <mxCell id="e23" value="" edge="1" parent="1" source="boot_start" target="boot_end" style="noEdgeStyle=1;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.7;strokeColor=#6A8090;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;dashed=0;dashPattern=5 4;">
