        <mxCell id="net_data" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#754A16&quot;&gt;&lt;b&gt;decode_data(json, expected_peer)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Les trois valeurs du champ acceleration sont des RMS.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;require(type&amp;nbsp;==&amp;nbsp;DATA&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;id&amp;nbsp;==&amp;nbsp;expected_peer);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;require(valid_utc_iso8601(timestamp));&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;require(isfinite(x)&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;isfinite(y)&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;isfinite(z));&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;require(x&amp;nbsp;&amp;gt;=&amp;nbsp;0&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;y&amp;nbsp;&amp;gt;=&amp;nbsp;0&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;z&amp;nbsp;&amp;gt;=&amp;nbsp;0);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;require(status&amp;nbsp;==&amp;nbsp;NORMAL&amp;nbsp;||&amp;nbsp;status&amp;nbsp;==&amp;nbsp;ALERT);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;return&amp;nbsp;measurement(id,&amp;nbsp;timestamp,&amp;nbsp;x,&amp;nbsp;y,&amp;nbsp;z,&amp;nbsp;status);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="net_ingest" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#754A16&quot;&gt;&lt;b&gt;ingest_remote(json, peer_id, context)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Point d’entrée commun aux mesures reçues par le client et le serveur.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!decode_data(json,&amp;nbsp;peer_id,&amp;nbsp;&amp;amp;frame))&amp;nbsp;return&amp;nbsp;BAD_DATA;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(remember_if_new(peer_id,&amp;nbsp;frame.utc))&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;queue_or_merge_fram_candidate(frame);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;post_validation(frame,&amp;nbsp;context);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Conserver&amp;nbsp;le&amp;nbsp;contexte&amp;nbsp;de&amp;nbsp;requête&amp;nbsp;ciblée&amp;nbsp;même&amp;nbsp;si&amp;nbsp;data&amp;nbsp;est&amp;nbsp;connu.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Si&amp;nbsp;la&amp;nbsp;file&amp;nbsp;déborde,&amp;nbsp;tracer&amp;nbsp;et&amp;nbsp;marquer&amp;nbsp;le&amp;nbsp;candidat&amp;nbsp;concerné.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="net_pick" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#754A16&quot;&gt;&lt;b&gt;select_event_frame(t0, delta)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Répondre sur la base de l’historique RMS local.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;snapshot&amp;nbsp;=&amp;nbsp;copy_history_snapshot();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;w&amp;nbsp;=&amp;nbsp;utc_range(t0&amp;nbsp;-&amp;nbsp;delta,&amp;nbsp;t0&amp;nbsp;+&amp;nbsp;delta);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!clock_valid()&amp;nbsp;||&amp;nbsp;!valid_delta(delta))&amp;nbsp;return&amp;nbsp;unavailable;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(has_local_alert(snapshot,&amp;nbsp;w))&amp;nbsp;return&amp;nbsp;closest_alert(w);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!covers_entire_window(snapshot,&amp;nbsp;w))&amp;nbsp;return&amp;nbsp;unavailable;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;return&amp;nbsp;closest_normal(w);&amp;nbsp;&amp;nbsp;//&amp;nbsp;créneau&amp;nbsp;couvert,&amp;nbsp;sans&amp;nbsp;alerte&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="654" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#CFDAE3;html=1;connectable=0;" vertex="1" parent="1">
