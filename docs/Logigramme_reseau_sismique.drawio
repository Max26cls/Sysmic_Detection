        <mxCell id="v17" value="HISTORIQUE.C  /  FENÊTRE DE 60 S ET CHOIX TCP" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1D695B;fontStyle=1;fillColor=none;strokeColor=none;connectable=0;" vertex="1" parent="1">
