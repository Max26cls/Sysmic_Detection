        <mxCell id="timer" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Timer matériel&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Déclenche un scan ADC X, Y, Z toutes les 10 ms.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="74" y="212" width="357" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dma" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;ADC et DMA&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Le DMA remplit un tampon double.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;L’ISR de fin de bloc notifie T02.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="74" y="312" width="357" height="83" as="geometry" />
        </mxCell>
        <mxCell id="acq" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Réveil de T02&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Récupérer le bloc stable avec son index temps.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Copier en file XYZ avant réutilisation par le DMA.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Signaler toute perte de bloc.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="74" y="430" width="357" height="96" as="geometry" />
        </mxCell>
        <mxCell id="again" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Attendre le prochain bloc DMA&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;La tâche est bloquée entre les notifications.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="74" y="582" width="357" height="70" as="geometry" />
        </mxCell>
        <mxCell id="filter" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Lire et filtrer un bloc&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Convertir et centrer X, Y, Z selon la calibration.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Appliquer une moyenne glissante de N points par axe.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="517" y="212" width="446" height="80" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Fenêtre complète ?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;100 points filtrés contigus&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="320" width="320" height="96" as="geometry" />
        </mxCell>
        <mxCell id="rms" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Calculer et dater les 3 RMS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Pour chaque axe, RMS = √(moyenne des carrés).&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Utiliser l’heure de fin de fenêtre fournie par T08.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="517" y="456" width="446" height="86" as="geometry" />
        </mxCell>
        <mxCell id="history" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Actualiser l’historique de 60 s&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Recalculer les dix plus grandes valeurs par axe.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="517" y="580" width="446" height="72" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#754A16&quot;&gt;&lt;b&gt;Appliquer le critère local&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Si le seuil est dépassé, publier un candidat vers T12.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#C89249;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="517" y="684" width="446" height="65" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Attendre une mise à jour&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Top 10 local OU maximum d’un pair.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;File FRAM alimentée par T03, T06 et T11.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1049" y="212" width="357" height="80" as="geometry" />
        </mxCell>
        <mxCell id="store" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#1D695B&quot;&gt;&lt;b&gt;Écrire un instantané via SPI&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Local : 10 RMS × 3 axes dans les 60 s.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Pair : 1 RMS max reçue × 3 axes par ID.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Conserver l’horodatage associé à chaque valeur.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Regrouper les écritures successives.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E3F3EF;strokeColor=#5B9D8D;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
