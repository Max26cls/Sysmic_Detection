        <mxCell id="tick" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Attendre l’échéance ou une demande de T12&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Échéance de synchronisation toutes les 60 s.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="144" y="211" width="472" height="70" as="geometry" />
        </mxCell>
        <mxCell id="select" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Préparer le lot à traiter&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Périodique : figer les pairs actifs et choisir une RMS datée.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Validation : utiliser les pairs et le créneau remis par T12.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Traiter les pairs un par un avec un délai par connexion.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="116" y="310" width="528" height="98" as="geometry" />
        </mxCell>
        <mxCell id="more" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Reste-t-il un pair ?&lt;/b&gt;&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="221" y="437" width="318" height="76" as="geometry" />
        </mxCell>
        <mxCell id="connect" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Se connecter au pair sur TCP 12345&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Périodique : envoyer son message data et demander le sien.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Validation : demander une mesure autour de l’instant candidat.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;En cas de délai ou d’erreur, informer T12 si concerné&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;et passer au pair suivant.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="116" y="548" width="528" height="113" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Lire la réponse et fermer la connexion&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Appliquer les mêmes contrôles et règles de stockage que T11.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Si la réponse est exploitable, prévenir T12 et T07 si nécessaire.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Traiter le pair suivant.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="116" y="693" width="528" height="111" as="geometry" />
        </mxCell>
        <mxCell id="listen" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Écouter sur TCP 12345&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Accepter une connexion ou revenir de l’attente sur délai.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="211" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="frame" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Lire et contrôler la requête&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Assembler les octets jusqu’à la fin de la trame JSON.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Contrôler taille, type, identité, horodatage et données.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="310" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Requête valide ?&lt;/b&gt;&lt;/div&gt;" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="429" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="bad" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#8D403B&quot;&gt;&lt;b&gt;Refuser&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Tracer le motif.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Fermer la connexion.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Reprendre l’écoute.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FCE9E8;strokeColor=#BE7E77;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="532" width="188" height="100" as="geometry" />
        </mxCell>
        <mxCell id="update" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Traiter la mesure reçue si présente&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Mettre à jour les données horodatées du pair.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Soumettre à T07 les maxima modifiés.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Transmettre à T12 la mesure et son statut local.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="788" y="541" width="409" height="111" as="geometry" />
        </mxCell>
        <mxCell id="reply" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#57418C&quot;&gt;&lt;b&gt;Répondre sur la même connexion&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Périodique : renvoyer la mesure locale retenue si disponible.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Validation : chercher un dépassement dans le créneau demandé.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Répondre normal si le créneau est couvert sans dépassement,&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;ou unavailable si les mesures manquent. Fermer la connexion.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9B87C4;strokeWidth=1.5;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="693" width="520" height="111" as="geometry" />
        </mxCell>
        <mxCell id="v29" value="Oui" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="395" y="520" width="52" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v31" value="Non" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="143" y="452" width="54" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v37" value="Oui" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1114" y="513" width="52" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v39" value="Non" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#43596B;fontStyle=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1267" y="441" width="51" height="22" as="geometry" />
        </mxCell>
        <mxCell id="note871" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Format d’échange proposé&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Une trame JSON par ligne. Requête sync avec data si disponible. Requête get_event avec un instant UTC et Δt. Pour les deux, réponse data ou unavailable.&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Objet data du sujet : type, id, timestamp (UTC), acceleration { x, y, z } pour les trois RMS et status (« normal » ou « alerte ») pour le dépassement local.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="871" width="1400" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
