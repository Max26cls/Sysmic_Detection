        <mxCell id="boot_main" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1F4B75&quot;&gt;&lt;b&gt;main()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Créer l’application une fois avant de lancer l’ordonnanceur.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;HAL_Init();&amp;nbsp;SystemClock_Config();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;init_GPIO_TIM_ADC_DMA_I2C_SPI_UART_ETH();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;init_ip_static(config.node_ip,&amp;nbsp;config.netmask);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;create_queues_mutexes_event_groups();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;create_tasks_and_check_results();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;vTaskStartScheduler();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;boot_fault();&amp;nbsp;&amp;nbsp;//&amp;nbsp;si&amp;nbsp;le&amp;nbsp;lancement&amp;nbsp;retourne&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="boot_irq" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1F4B75&quot;&gt;&lt;b&gt;HAL_GPIO_EXTI_Callback(pin)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;L’ISR du bouton transmet un signal à T01.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(pin&amp;nbsp;!=&amp;nbsp;BUTTON_PIN&amp;nbsp;||&amp;nbsp;!scheduler_ready)&amp;nbsp;return;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;BaseType_t&amp;nbsp;wake&amp;nbsp;=&amp;nbsp;pdFALSE;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;vTaskNotifyGiveFromISR(master_handle,&amp;nbsp;&amp;amp;wake);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;portYIELD_FROM_ISR(wake);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Dans&amp;nbsp;T01&amp;nbsp;:&amp;nbsp;filtrer&amp;nbsp;les&amp;nbsp;rebonds&amp;nbsp;et&amp;nbsp;valider&amp;nbsp;un&amp;nbsp;seul&amp;nbsp;appui.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Configurer&amp;nbsp;les&amp;nbsp;priorités&amp;nbsp;IRQ&amp;nbsp;compatibles&amp;nbsp;avec&amp;nbsp;FromISR.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="boot_worker" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1F4B75&quot;&gt;&lt;b&gt;worker_begin() / worker_end()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Patron commun à T02–T12, avec nettoyage propre à la tâche.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;wait_event(RUN);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;prepare_owned_resource();&amp;nbsp;set_ready_bit(self);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Boucle&amp;nbsp;métier&amp;nbsp;:&amp;nbsp;attente&amp;nbsp;bornée,&amp;nbsp;puis&amp;nbsp;relire&amp;nbsp;RUN.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;T07&amp;nbsp;et&amp;nbsp;T10&amp;nbsp;restent&amp;nbsp;actifs&amp;nbsp;jusqu&amp;#x27;à&amp;nbsp;leur&amp;nbsp;ordre&amp;nbsp;de&amp;nbsp;vidage.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;finish_current_work();&amp;nbsp;release_owned_resource();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;set_stopped_bit(self);&amp;nbsp;&amp;nbsp;//&amp;nbsp;la&amp;nbsp;boucle&amp;nbsp;revient&amp;nbsp;sur&amp;nbsp;RUN&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="63" y="654" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#CFDAE3;html=1;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="758" y="145" width="682" height="738" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="" style="rounded=1;arcSize=12;fillColor=#E7EFF9;strokeColor=none;html=1;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="770" y="157" width="658" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="APP_CONTROL.C  /  T01 MAÎTRE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1F4B75;fontStyle=1;fillColor=none;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="782" y="157" width="634" height="36" as="geometry" />
        </mxCell>
        <mxCell id="boot_master" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1F4B75&quot;&gt;&lt;b&gt;master_task()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;T01 transforme les appuis validés en commandes de cycle.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;scheduler_ready&amp;nbsp;=&amp;nbsp;true;&amp;nbsp;enable_button_irq();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;for&amp;nbsp;(;;)&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;wait_debounced_button_press();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(!begin_cycle(START_TIMEOUT))&amp;nbsp;enter_fault();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;wait_stop_press_or_use_pending_press();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(!stop_cycle(STOP_TIMEOUTS))&amp;nbsp;enter_fault();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="boot_start" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1F4B75&quot;&gt;&lt;b&gt;begin_cycle(deadline)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Réveiller les services et contrôler leurs confirmations.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;clear_ready_stopped_and_flush_bits();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;reset_run_state_and_reset_queues_when_quiescent();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;set_event(RUN);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;return&amp;nbsp;wait_all_ready(deadline);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;T08&amp;nbsp;peut&amp;nbsp;lancer&amp;nbsp;son&amp;nbsp;essai&amp;nbsp;NTP&amp;nbsp;après&amp;nbsp;READY.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="boot_end" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1F4B75&quot;&gt;&lt;b&gt;stop_cycle(deadlines)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Couper les producteurs, enregistrer en FRAM, puis vider l’UART.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;clear_event(RUN);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!wait_stopped(PRODUCERS,&amp;nbsp;d1))&amp;nbsp;return&amp;nbsp;false;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;set_event(FLUSH_FRAM);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!wait_stopped(T07,&amp;nbsp;d2))&amp;nbsp;return&amp;nbsp;false;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;set_event(FLUSH_UART);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!wait_stopped(T10,&amp;nbsp;d3))&amp;nbsp;return&amp;nbsp;false;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;discard_stale_jobs();&amp;nbsp;return&amp;nbsp;true;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="654" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="note890" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Intégration&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;Les initialisations HAL dépendent du .ioc et du pilote Ethernet. Garder un seul propriétaire du timer/ADC/DMA, de la FRAM, de la RTC et de l’UART.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1400" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
