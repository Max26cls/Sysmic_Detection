        <mxCell id="v17" value="TIME_SYNC.C  /  T08 RTC ET CONVERSION UTC" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1F4B75;fontStyle=1;fillColor=none;strokeColor=none;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="782" y="157" width="634" height="36" as="geometry" />
        </mxCell>
        <mxCell id="rtc_task" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1F4B75&quot;&gt;&lt;b&gt;rtc_task() / boot_ntp_sync()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Publier la RTC valide, puis essayer NTP au premier démarrage.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;wait_event(RUN);&amp;nbsp;refresh_rtc_anchor();&amp;nbsp;ready(T08);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(first_cycle&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;link_can_start())&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;utc&amp;nbsp;=&amp;nbsp;ntp_query_until(&amp;#x27;be.pool.ntp.org&amp;#x27;,&amp;nbsp;NTP_TIMEOUT);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;(utc.valid&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;run_is_set())&amp;nbsp;set_rtc_and_publish(utc);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;while&amp;nbsp;(run_is_set())&amp;nbsp;refresh_rtc_on_bounded_period();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;finish_i2c();&amp;nbsp;stopped(T08);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="204" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="rtc_anchor" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1F4B75&quot;&gt;&lt;b&gt;refresh_rtc_anchor()&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Lire la RTC via I²C et publier un couple UTC / temps monotone.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;rtc&amp;nbsp;=&amp;nbsp;rtc_read_with_timeout();&amp;nbsp;tick&amp;nbsp;=&amp;nbsp;monotonic_now();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!rtc_ok_and_calendar_valid(rtc))&amp;nbsp;return&amp;nbsp;mark_utc_invalid();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;offset&amp;nbsp;=&amp;nbsp;utc_from_rtc(rtc)&amp;nbsp;-&amp;nbsp;ticks_to_duration(tick);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(offset_jumps_beyond_limit(offset))&amp;nbsp;{&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;advance_clock_generation();&amp;nbsp;notify_validation_clock_changed();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;}&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;publish_utc_anchor(offset,&amp;nbsp;tick,&amp;nbsp;clock_generation);&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="429" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="rtc_convert" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:18px;line-height:22px;color:#1F4B75&quot;&gt;&lt;b&gt;utc_from_tick(sample_tick)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Segoe UI, sans-serif;font-size:15px;line-height:19px;color:#43596B&quot;&gt;Dater l’échantillon. Utiliser l’horloge monotone pour les délais.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;a&amp;nbsp;=&amp;nbsp;copy_time_anchor_under_mutex();&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;if&amp;nbsp;(!a.valid&amp;nbsp;||&amp;nbsp;anchor_too_old(a))&amp;nbsp;return&amp;nbsp;INVALID_UTC;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;return&amp;nbsp;utc_stamp(a.offset&amp;nbsp;+&amp;nbsp;ticks_to_duration(sample_tick),&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;a.clock_generation);&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;Après&amp;nbsp;un&amp;nbsp;saut&amp;nbsp;d&amp;#x27;heure&amp;nbsp;:&amp;nbsp;exclure&amp;nbsp;l&amp;#x27;ancienne&amp;nbsp;génération.&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, monospace;font-size:14px;line-height:18px;color:#142839&quot;&gt;//&amp;nbsp;FRAM&amp;nbsp;:&amp;nbsp;garder&amp;nbsp;la&amp;nbsp;RMS&amp;nbsp;locale&amp;nbsp;avec&amp;nbsp;le&amp;nbsp;flag&amp;nbsp;UTC&amp;nbsp;invalide.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7EFF9;strokeColor=#6A91B5;strokeWidth=1.4;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="781" y="654" width="636" height="205" as="geometry" />
        </mxCell>
        <mxCell id="note890" value="&lt;div style=&quot;font-size:17px;line-height:21px;color:#25465B&quot;&gt;&lt;b&gt;Intégration&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:19px;color:#142839&quot;&gt;FRAM : enregistrer la date de chaque maximum. Si NTP est indisponible, garder la RTC valide. Sans heure valide, poursuivre les mesures locales.&lt;/div&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCBD6;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1400" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
